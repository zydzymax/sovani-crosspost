# Database Configuration
DATABASE_URL=postgresql://sovani:[REVOKED_SECRET_REMOVED]@localhost:5432/sovani_crosspost

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# S3/MinIO Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=[REVOKED_SECRET_REMOVED]
S3_SECRET_KEY=[REVOKED_SECRET_REMOVED]
S3_BUCKET_NAME=sovani-media
S3_REGION=us-east-1

# Security & Encryption
AES_KEY=your-256-bit-aes-key-here-32-chars
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here

# Telegram Bot Configuration - РЕАЛЬНЫЕ ДАННЫЕ
TG_BOT_TOKEN=[REVOKED_SECRET_REMOVED]
TG_PUBLISHING_BOT_TOKEN=[REVOKED_TOKEN_REMOVED]
TG_ADMIN_CHANNEL_ID=-1001234567890
TG_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# VK API Configuration - РЕАЛЬНЫЕ ДАННЫЕ
VK_SERVICE_TOKEN=[REVOKED_SECRET_REMOVED]
VK_GROUP_ID=123456789

# Meta/Instagram Configuration
META_APP_ID=your-meta-app-id
META_APP_SECRET=[REVOKED_SECRET_REMOVED]
META_ACCESS_TOKEN=[REVOKED_SECRET_REMOVED]

# TikTok Configuration
TIKTOK_CLIENT_KEY=[REVOKED_SECRET_REMOVED]
TIKTOK_CLIENT_SECRET=[REVOKED_SECRET_REMOVED]
TIKTOK_REDIRECT_URI=https://your-domain.com/auth/tiktok/callback

# YouTube Configuration
YOUTUBE_CLIENT_ID=your-youtube-client-id.googleusercontent.com
YOUTUBE_CLIENT_SECRET=[REVOKED_SECRET_REMOVED]
YOUTUBE_REDIRECT_URI=https://your-domain.com/auth/youtube/callback

# Proxy Configuration (for geo-restricted APIs)
IG_PROXY_URL=http://proxy-server:port
TIKTOK_PROXY_URL=http://proxy-server:port

# Brand & Localization
BRAND_TZ=Europe/Moscow
BRAND_NAME=SoVAni
BRAND_HANDLE=@sovani_official

# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000

# Media Processing Configuration
MAX_FILE_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS=mp4,mov,avi,mkv
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Rate Limiting & Retry Configuration
API_RATE_LIMIT_PER_MINUTE=100
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2