# Database Configuration
DATABASE_URL=postgresql://user:change_me@localhost:5433/dbname

# Redis Configuration
REDIS_URL=redis://localhost:6380/2

# S3/MinIO Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=media-bucket
S3_REGION=us-east-1

# Security & Encryption (generate random 32-byte keys)
AES_KEY=your-32-byte-aes-encryption-key!
TOKEN_ENCRYPTION_KEY=your-32-byte-token-encrypt-key!
JWT_SECRET_KEY=your-jwt-secret-key-here

# Telegram Bot Configuration
TG_BOT_TOKEN=your-telegram-bot-token
TG_PUBLISHING_BOT_TOKEN=your-publishing-bot-token
TG_ADMIN_CHANNEL_ID=-100xxxxxxxxxx
TG_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# VK API Configuration
VK_SERVICE_TOKEN=your-vk-service-token
VK_GROUP_ID=your-vk-group-id

# Meta/Instagram Configuration
META_APP_ID=your-meta-app-id
META_APP_SECRET=change_me
META_ACCESS_TOKEN=change_me

# TikTok Configuration
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-domain.com/auth/tiktok/callback

# YouTube Configuration
YOUTUBE_CLIENT_ID=your-youtube-client-id.googleusercontent.com
YOUTUBE_CLIENT_SECRET=change_me
YOUTUBE_REDIRECT_URI=https://your-domain.com/auth/youtube/callback

# Proxy Configuration (optional, for geo-restricted APIs)
# IG_PROXY_URL=http://proxy-server:8080
# TIKTOK_PROXY_URL=http://proxy-server:8080

# Brand & Localization
BRAND_TZ=Europe/Moscow
BRAND_NAME=YourBrand

# OPS Alerts (optional)
# Set to 1 to receive success alerts in addition to failure alerts
OPS_ALERT_NOTIFY_SUCCESS=0

# Telegram alerts
# OPS_ALERT_TELEGRAM_BOT_TOKEN=123456:ABCDEF
# OPS_ALERT_TELEGRAM_CHAT_ID=-1001234567890

# Webhook alerts
# OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/ops-alerts
# OPS_ALERT_WEBHOOK_BEARER_TOKEN=secret-token
# OPS_ALERT_WEBHOOK_AUTH_HEADER=X-Webhook-Token: secret-value

# SMTP email alerts
# OPS_ALERT_SMTP_HOST=smtp.yandex.ru
# OPS_ALERT_SMTP_PORT=465
# OPS_ALERT_SMTP_USER=alerts@example.com
# OPS_ALERT_SMTP_PASSWORD=app-password
# OPS_ALERT_SMTP_FROM=SalesWhisper Ops <alerts@example.com>
# OPS_ALERT_SMTP_TO=devops@example.com,owner@example.com
# OPS_ALERT_SMTP_USE_SSL=1
# OPS_ALERT_SMTP_STARTTLS=0

# Ops logs (used by cron runbook, optional)
# OPS_LOG_DIR=/root/saleswhisper_crosspost/logs/ops
